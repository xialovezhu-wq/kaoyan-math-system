{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reviewed mathematics formula display (derived, not learner evidence)",
  "type": "object",
  "required": [
    "schema", "card_id", "concept_key", "title", "kind", "source_refs", "source_version",
    "assumptions_latex", "conclusion_latex", "step_latex", "guard_note", "detail_ref",
    "representation_version", "scope", "allowed_views"
  ],
  "properties": {
    "schema": {"const": "math-formula-card-v1"},
    "card_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,159}$"},
    "concept_key": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "kind": {"enum": ["basic_formula", "secondary_conclusion"]},
    "source_refs": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "pdf_page": {"type": "integer", "minimum": 1},
          "pdf_pages": {"type": "array", "items": {"type": "integer", "minimum": 1}},
          "section": {"type": "string"}
        }
      }
    },
    "source_version": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "assumptions_latex": {
      "type": "array",
      "items": {
        "type": "object", "minProperties": 1, "additionalProperties": false,
        "properties": {"latex": {"type": "string", "minLength": 1}, "label": {"type": "string", "minLength": 1}}
      }
    },
    "no_extra_assumptions_reason": {"type": "string", "minLength": 1},
    "conclusion_latex": {"type": "string", "minLength": 1},
    "step_latex": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "guard_note": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "detail_ref": {"type": "object", "required": ["path", "entry_id"]},
    "representation_version": {"const": "math-formula-card-v1"},
    "scope": {
      "type": "object", "required": ["type", "stage"],
      "properties": {
        "type": {"enum": ["general_reference", "exact_question"]},
        "stage": {"const": "reviewed_reference"},
        "question_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      },
      "if": {"properties": {"type": {"const": "exact_question"}}},
      "then": {"required": ["question_ids"]}
    },
    "allowed_views": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"enum": ["direct", "after_attempt"]}
    },
    "diagram_ref": {"type": "object", "required": ["path", "scope"]}
  },
  "if": {"properties": {"assumptions_latex": {"maxItems": 0}}},
  "then": {"required": ["no_extra_assumptions_reason"]}
}
